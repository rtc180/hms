# Copy to .env.local for local development. Use Supabase's Transaction pooler URL (port 6543).
DATABASE_URL=

# Generate a unique secret with at least 32 characters. Never reuse a sample value.
JWT_SECRET=

# Optional locally. In Vercel, set this to your public production URL to use it for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional provider CA certificate PEM. Leave unset when the connection URL verifies its TLS certificate.
# DATABASE_CA_CERT=
